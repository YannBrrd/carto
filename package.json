{
  "name": "carto",
  "version": "1.2.1",
  "description": "Interactive map editor with OSM data and SVG export",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build:main -- --watch\" \"npm run build:renderer -- --watch\" \"wait-on dist/main/main.js && electron .\"",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.config.js",
    "build:prod": "npm run build && electron-builder",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "map",
    "osm",
    "svg",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.5.4",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "build": {
    "appId": "com.carto.app",
    "productName": "Carto",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/icon/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "src/icon/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/icon/icon.png",
      "category": "Graphics"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "src/icon/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": null
    }
  }
}
